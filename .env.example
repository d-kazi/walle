# WhatsApp (Meta Business Cloud API)
META_WA_TOKEN=
META_WA_PHONE_ID=
META_WA_VERIFY_TOKEN=
META_APP_SECRET=
# optional: enables daily_brief template status in /health
META_WABA_ID=
WA_ID_DAN=
WA_ID_ALINA=

# LLM (OpenAI-compatible; default host is OpenRouter with ZDR routing)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
WALLE_MODEL=deepseek/deepseek-chat
WALLE_MODEL_ESCALATED=deepseek/deepseek-chat

# Voice transcription
GROQ_API_KEY=

# Google (four principals; refresh tokens from `npm run auth`)
# dan/alina grant calendar only. school and walle are dedicated mailboxes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_DAN=
GOOGLE_REFRESH_ALINA=
GOOGLE_REFRESH_SCHOOL=
GOOGLE_REFRESH_WALLE=
FAMILY_DRIVE_FOLDER_ID=

# The only two addresses allowed to forward mail to the Wall-E inbox
EMAIL_DAN=
EMAIL_ALINA=

# Ledger push (walle-finance on Dan's Mac)
LEDGER_PUSH_TOKEN=

# Service
TZ=Asia/Riyadh
PORT=3000
DATA_DIR=/data
